---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Visuel from '../../components/Visuel.astro';
import Lettre from '../../components/Lettre.astro';
import { cartelsPublies, dateLongue } from '../../lib/format';

export async function getStaticPaths() {
  const cartels = await cartelsPublies();
  return cartels.map((c) => ({ params: { slug: c.id }, props: { cartel: c } }));
}
const { cartel } = Astro.props;
const { data } = cartel;
const { Content } = await render(cartel);
---
<Base titre={data.titre} description={data.chapo} type="article">
  <article data-pagefind-body>
    <header class="tete">
      <div class="surtitre"><a href="/cartels/">Le cartel de la semaine</a></div>
      <h1>{data.titre}</h1>
      <p class="chapo">{data.chapo}</p>
      <div class="meta">Par {data.auteur} · <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time></div>
    </header>
    <div class="scene">
      <div class="scene-visuel"><Visuel visuel={data.image} hauteur="520px" legende /></div>
      <div class="etiquette" aria-label="Cartel de l’œuvre">
        <div class="et-artiste">{data.artiste}</div>
        <div class="et-oeuvre">{data.oeuvre}</div>
        <div class="mono et-details">
          <div>{data.technique}</div>
          {data.details.map((d) => <div>{d}</div>)}
          {data.mention && <div class="et-mention">{data.mention}</div>}
        </div>
      </div>
    </div>
    <div class="colonnes"><div class="corps"><Content /></div></div>
  </article>
  <Lettre sombre />
</Base>

<style>
  .tete { max-width: 900px; margin: 0 auto; padding: 72px 0 48px; text-align: center; }
  .surtitre { font-size: 12px; margin-bottom: 24px; }
  h1 { margin: 0 0 24px; font-size: clamp(40px, 5vw, 68px); line-height: 1.02; font-weight: 400; }
  .chapo { margin: 0 auto 24px; max-width: 720px; font-size: 22px; line-height: 1.45; color: var(--texte); }
  .scene { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; margin-bottom: 64px; }
  .scene-visuel { flex: 3 1 480px; min-width: 0; }
  .etiquette { flex: 1 1 300px; max-width: 420px; border: 1px solid var(--encre); padding: 28px 32px; }
  .et-artiste { font-size: 24px; font-weight: 500; }
  .et-oeuvre { font-size: 24px; font-style: italic; margin-bottom: 14px; }
  .et-details { font-size: 12px; line-height: 1.75; color: var(--texte); }
  .et-mention { color: var(--gris); margin-top: 10px; }
  .colonnes { display: flex; flex-wrap: wrap; gap: 48px; justify-content: center; padding-bottom: 72px; }
</style>
