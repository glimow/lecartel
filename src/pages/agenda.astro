---
import Base from '../layouts/Base.astro';
import ListeAgenda from '../components/ListeAgenda.astro';
import { agendaEnCours } from '../lib/format';

const tous = await agendaEnCours();
const maintenant = new Date();
const enCours = tous.filter((e) => e.data.debut <= maintenant);
const aVenir = tous.filter((e) => e.data.debut > maintenant).sort((a, b) => a.data.debut.valueOf() - b.data.debut.valueOf());
---
<Base titre="Agenda" description="Les expositions et événements que la rédaction juge dignes d’être vus, à Paris et autour.">
  <header class="entete-liste">
    <h1>Agenda</h1>
    <p>Ce que la rédaction juge digne d’être vu, à Paris et autour. Trié par date de fermeture : allez-y d’abord.</p>
  </header>
  <div class="deux">
    <section aria-labelledby="t-encours">
      <h2 class="titre-section" id="t-encours">En ce moment</h2>
      <ListeAgenda evenements={enCours} />
    </section>
    <section aria-labelledby="t-avenir">
      <h2 class="titre-section" id="t-avenir">Bientôt</h2>
      {aVenir.length ? <ListeAgenda evenements={aVenir} /> : <p class="meta">Rien d’annoncé pour l’instant.</p>}
    </section>
  </div>
</Base>

<style>
  .entete-liste { padding: 64px 0 40px; border-bottom: 1px solid var(--encre); margin-bottom: 48px; }
  h1 { margin: 0 0 12px; font-size: clamp(48px, 7vw, 96px); font-weight: 400; font-style: italic; line-height: 1; }
  .entete-liste p { margin: 0; font-size: 22px; color: var(--texte); max-width: 720px; }
  .deux { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 56px; padding-bottom: 72px; }
</style>
