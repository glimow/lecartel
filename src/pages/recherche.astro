---
import Base from '../layouts/Base.astro';
---
<Base titre="Rechercher">
  <header class="entete-liste">
    <h1>Rechercher</h1>
  </header>
  <div id="recherche" class="recherche"></div>
  <noscript><p>La recherche nécessite JavaScript.</p></noscript>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) {
        document.getElementById('recherche').innerHTML =
          '<p class="meta">L’index de recherche est généré au moment du build (npm run build).</p>';
        return;
      }
      new window.PagefindUI({
        element: '#recherche',
        showSubResults: true,
        showImages: false,
        translations: { placeholder: 'Un artiste, un lieu, une idée…', zero_results: 'Aucun résultat pour [SEARCH_TERM]' },
      });
    });
  </script>
</Base>

<style>
  .entete-liste { padding: 64px 0 32px; }
  h1 { margin: 0; font-size: clamp(48px, 7vw, 96px); font-weight: 400; font-style: italic; line-height: 1; }
  .recherche {
    padding-bottom: 96px; max-width: 900px;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--encre);
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: var(--encre);
    --pagefind-ui-tag: var(--emplacement);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--serif);
  }
</style>
