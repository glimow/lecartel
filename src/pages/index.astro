---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Visuel from '../components/Visuel.astro';
import CarteArticle from '../components/CarteArticle.astro';
import ListeAgenda from '../components/ListeAgenda.astro';
import Lettre from '../components/Lettre.astro';
import { rubrique } from '../data/rubriques';
import { articlesPublies, cartelsPublies, agendaEnCours, tempsDeLecture, dateCourte } from '../lib/format';

const articles = await articlesPublies();
const une = articles.find((a) => a.data.une) ?? articles[0];
const reste = articles.filter((a) => a.id !== une?.id);

// Dossier mis en avant : le plus récent marqué `accueil: true`
const dossiers = (await getCollection('dossiers', (d) => d.data.accueil)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const dossier = dossiers[0];
const articlesDossier = dossier ? articles.filter((a) => a.data.dossier?.id === dossier.id) : [];
const tete = articlesDossier[0];

const exclus = new Set([une?.id, tete?.id]);
const disponibles = reste.filter((a) => !exclus.has(a.id));
const trois = disponibles.slice(0, 3);
const critiques = disponibles.slice(3, 7);

const cartel = (await cartelsPublies())[0];
const agenda = (await agendaEnCours()).slice(0, 7);
---
<Base grandTitre>
  {une && (
    <section class="une" aria-label="À la une">
      <a href={`/articles/${une.id}/`} class="une-visuel" tabindex="-1" aria-hidden="true">
        <Visuel visuel={une.data.image} hauteur="620px" sizes="(max-width: 1000px) 100vw, 58vw" prioritaire />
      </a>
      <div class="une-texte">
        <div>
          <div class="surtitre une-surtitre">À la une — {rubrique(une.data.rubrique).singulier} · {une.data.sujet}</div>
          <h2><a href={`/articles/${une.id}/`}>{une.data.titre}</a></h2>
          <p class="chapo">{une.data.chapo}</p>
        </div>
        <div>
          {une.data.cartel.length > 0 && (
            <ul class="cartel-liste mono">
              {une.data.cartel.map((c) => (
                <li><span><i>{c.titre}</i> — {c.lieu}</span><span class="gris">{c.dates}</span></li>
              ))}
            </ul>
          )}
          <div class="meta">Par {une.data.auteur} · {tempsDeLecture(une.body)} min de lecture</div>
        </div>
      </div>
    </section>
  )}

  {trois.length > 0 && (
    <section class="trois" aria-label="Articles récents">
      {trois.map((a) => <CarteArticle article={a} />)}
    </section>
  )}

  {cartel && (
    <section class="bande" aria-labelledby="cartel-titre">
      <div class="bande-texte">
        <div class="surtitre clair">Rubrique — Le cartel de la semaine</div>
        <h2 id="cartel-titre">{cartel.data.titre}</h2>
        <p>{cartel.data.chapo}</p>
        <a class="bouton blanc" href={`/cartels/${cartel.id}/`}>Lire le cartel</a>
      </div>
      <div class="bande-cartel">
        <div class="etiquette">
          <div class="et-artiste">{cartel.data.artiste}</div>
          <div class="et-oeuvre">{cartel.data.oeuvre}</div>
          <div class="mono et-details">
            <div>{cartel.data.technique}</div>
            {cartel.data.details.map((d) => <div>{d}</div>)}
            {cartel.data.mention && <div class="gris et-mention">{cartel.data.mention}</div>}
          </div>
        </div>
      </div>
    </section>
  )}

  {dossier && (
    <section class="dossier" aria-labelledby="dossier-titre">
      <div class="dossier-tete">
        <h2 id="dossier-titre"><a href={`/dossiers/${dossier.id}/`}>Dossier — {dossier.data.titre}</a></h2>
        <span class="meta">{articlesDossier.length} article{articlesDossier.length > 1 ? 's' : ''} · mis à jour le {dateCourte(dossier.data.date)}</span>
      </div>
      <div class="dossier-corps">
        <div class="dossier-principal">
          {tete ? (
            <>
              <a href={`/articles/${tete.id}/`} class="dossier-visuel" tabindex="-1" aria-hidden="true">
                <Visuel visuel={tete.data.image} hauteur="340px" largeurs={[400, 700]} sizes="(max-width: 760px) 100vw, 30vw" />
              </a>
              <div class="dossier-article">
                <div class="surtitre">{rubrique(tete.data.rubrique).singulier} · {tete.data.sujet}</div>
                <h3><a href={`/articles/${tete.id}/`}>{tete.data.titre}</a></h3>
                <p>{tete.data.chapo}</p>
                <div class="meta">Par {tete.data.auteur}</div>
              </div>
            </>
          ) : (
            <p class="dossier-intro">{dossier.data.intro}</p>
          )}
        </div>
        {dossier.data.encadre && (
          <aside class="encadre" aria-label={dossier.data.encadre.titre}>
            <div class="mono encadre-titre">{dossier.data.encadre.titre}</div>
            <ul>
              {dossier.data.encadre.items.map((i) => (
                <li><span class="mono">{i.date}</span><span>{i.texte}</span></li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>
  )}

  <section class="bas">
    <div class="bas-critiques">
      <h2 class="titre-section">Derniers articles</h2>
      {critiques.map((a, i) => (
        <article class="ligne">
          <span class="numero">{String(i + 1).padStart(2, '0')}</span>
          <div class="ligne-texte">
            <div class="mono ligne-surtitre">{rubrique(a.data.rubrique).singulier} · {a.data.sujet}</div>
            <h3><a href={`/articles/${a.id}/`}>{a.data.titre}</a></h3>
            <p>{a.data.chapo}</p>
          </div>
        </article>
      ))}
    </div>
    <aside class="bas-agenda" aria-labelledby="agenda-titre">
      <h2 class="titre-section" id="agenda-titre">Agenda — à voir</h2>
      <ListeAgenda evenements={agenda} />
      <a href="/agenda/" class="mono tout">Tout l’agenda →</a>
    </aside>
  </section>

  <Lettre />
</Base>

<style>
  .une { display: flex; flex-wrap: wrap; gap: 48px; padding: 56px 0 64px; border-bottom: 1px solid var(--filet); }
  .une-visuel { flex: 7 1 560px; min-width: 0; display: block; }
  .une-texte { flex: 5 1 380px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .une-surtitre { font-size: 12px; margin-bottom: 20px; }
  .une h2 { margin: 0 0 24px; font-size: clamp(40px, 4.4vw, 62px); line-height: 1.02; font-weight: 400; letter-spacing: -0.02em; }
  .chapo { margin: 0; font-size: 22px; line-height: 1.45; color: var(--texte); }
  .cartel-liste { list-style: none; margin: 0 0 18px; padding: 14px 0 0; border-top: 1px solid var(--encre); font-size: 12px; line-height: 1.7; }
  .cartel-liste li { display: flex; justify-content: space-between; gap: 16px; padding: 4px 0; border-bottom: 1px dotted var(--pointille); }
  .cartel-liste li:last-child { border-bottom: 0; }
  .cartel-liste i { font-family: var(--serif); font-size: 14px; }
  .gris { color: var(--gris); white-space: nowrap; }

  .trois {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;
    padding: 56px 0; border-bottom: 1px solid var(--filet);
  }

  .bande {
    background: var(--encre); color: #fff; margin: 64px calc(-1 * var(--marge));
    padding: 72px var(--marge); display: flex; flex-wrap: wrap; gap: 56px; align-items: center;
  }
  .bande-texte, .bande-cartel { flex: 1 1 380px; min-width: 0; }
  .clair { color: var(--accent-clair); font-size: 12px; margin-bottom: 20px; }
  .bande h2 { margin: 0 0 20px; font-size: clamp(34px, 3.4vw, 48px); line-height: 1.05; font-weight: 400; }
  .bande p { margin: 0 0 28px; font-size: 19px; line-height: 1.5; color: #d6d6d2; }
  .blanc { background: #fff; color: var(--encre); }
  .blanc:hover { background: var(--accent-clair); color: var(--encre); }
  .bande-cartel { display: flex; justify-content: center; }
  .etiquette { background: #fff; color: var(--encre); padding: 32px 36px; width: 100%; max-width: 440px; }
  .et-artiste { font-size: 26px; font-weight: 500; }
  .et-oeuvre { font-size: 26px; font-style: italic; margin-bottom: 16px; }
  .et-details { font-size: 12px; line-height: 1.75; color: var(--texte); }
  .et-mention { margin-top: 10px; white-space: normal; }

  .dossier { padding: 8px 0 64px; border-bottom: 1px solid var(--filet); }
  .dossier-tete {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px;
    border-bottom: 1px solid var(--encre); padding-bottom: 14px; margin-bottom: 40px;
  }
  .dossier-tete h2 { margin: 0; font-size: 40px; font-weight: 400; font-style: italic; }
  .dossier-corps { display: flex; flex-wrap: wrap; gap: 48px; }
  .dossier-principal { flex: 3 1 480px; min-width: 0; display: flex; flex-wrap: wrap; gap: 32px; }
  .dossier-visuel { flex: 1 1 260px; min-width: 0; display: block; }
  .dossier-article { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .dossier-article h3 { margin: 0; font-size: 34px; line-height: 1.08; font-weight: 400; }
  .dossier-article p, .dossier-intro { margin: 0; font-size: 17px; line-height: 1.5; color: var(--texte); }
  .encadre { flex: 1 1 280px; min-width: 0; border-top: 2px solid var(--encre); padding-top: 16px; }
  .encadre-titre { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px; }
  .encadre ul { list-style: none; margin: 0; padding: 0; }
  .encadre li { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--filet); font-size: 17px; line-height: 1.35; }
  .encadre li:last-child { border-bottom: 0; }
  .encadre li .mono { font-size: 12px; color: var(--accent); min-width: 52px; padding-top: 3px; }

  .bas { display: flex; flex-wrap: wrap; gap: 56px; padding: 56px 0; }
  .bas-critiques { flex: 999 1 560px; min-width: 0; }
  .bas-agenda { flex: 1 1 300px; min-width: 0; }
  .ligne { display: flex; flex-wrap: wrap; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--filet); }
  .ligne:last-child { border-bottom: 0; }
  .numero { font-size: 44px; font-style: italic; color: var(--accent); min-width: 56px; line-height: 1; }
  .ligne-texte { flex: 1 1 360px; min-width: 0; }
  .ligne-surtitre { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gris); margin-bottom: 8px; }
  .ligne h3 { margin: 0 0 8px; font-size: 28px; line-height: 1.15; font-weight: 400; }
  .ligne p { margin: 0; font-size: 17px; line-height: 1.5; color: var(--texte); }
  .tout { display: inline-block; margin-top: 8px; padding: 12px 0; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
</style>
