---
import { lien } from '../lib/lien';
import '../styles/global.css';
import { SITE } from '../data/site';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import policeTexte from '../assets/fonts/newsreader-opsz-normal.woff2?url';

interface Props {
  titre?: string;
  description?: string;
  image?: string;
  /** Grand titre de la revue (accueil) ou en-tête compact (autres pages) */
  grandTitre?: boolean;
  type?: 'website' | 'article';
}
const { titre, description = SITE.description, image, grandTitre = false, type = 'website' } = Astro.props;
const titreComplet = titre ? `${titre} — ${SITE.nom}` : `${SITE.nom} — ${SITE.description}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
// Image de partage : celle de l’article, sinon la carte par défaut de la revue
const imagePartage = new URL(image ?? lien('/og-defaut.png'), Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={lien("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.nom} href={lien("/rss.xml")} />
    <link rel="sitemap" href={lien("/sitemap-index.xml")} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titre ?? SITE.nom} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:alt" content={titre ?? SITE.nom} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="visually-hidden" href="#contenu">Aller au contenu</a>
    <div class="page">
      <EnTete grandTitre={grandTitre} />
      <main id="contenu">
        <slot />
      </main>
      <PiedDePage />
    </div>
  </body>
</html>
