---
import type { CollectionEntry } from 'astro:content';
import { datesAgenda } from '../lib/format';
interface Props { evenements: CollectionEntry<'agenda'>[] }
const { evenements } = Astro.props;
---
<ul class="agenda">
  {evenements.map((e) => (
    <li>
      <div class="mono date">{datesAgenda(e)}</div>
      <div class="titre">{e.data.lien ? <a href={e.data.lien}>{e.data.titre}</a> : e.data.titre}</div>
      <div class="mono lieu">{e.data.artiste ? `${e.data.artiste} — ` : ''}{e.data.lieu}</div>
    </li>
  ))}
</ul>

<style>
  .agenda { list-style: none; margin: 0; padding: 0; }
  li { padding: 16px 0; border-bottom: 1px solid var(--filet); }
  li:last-child { border-bottom: 0; }
  .date { font-size: 11px; color: var(--accent); }
  .titre { font-size: 18px; font-style: italic; line-height: 1.3; }
  .lieu { font-size: 11px; color: var(--gris); }
</style>
